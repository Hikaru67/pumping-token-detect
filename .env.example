# MEXC API Configuration
MEXC_API_URL=https://futures.mexc.com/api/v1/contract/ticker
MEXC_KLINE_API_BASE_URL=https://futures.mexc.com/api/v1/contract/kline

# Telegram Bot Configuration
# Lấy bot token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
# Lấy chat ID từ @userinfobot hoặc từ Telegram API
TELEGRAM_CHAT_ID=

# Telegram Channel - Drop Tokens (mới)
TELEGRAM_DROP_CHAT_ID=

# Scheduler Configuration (Cron format)
# Mặc định: mỗi 1 phút
CRON_SCHEDULE=*/1 * * * *

# Storage Configuration
DATA_DIR=./data
HISTORY_FILE=./data/top10_history.json

# Scheduler (có thể config riêng)
CRON_SCHEDULE=*/1 * * * *          # Pump tokens: mỗi 1 phút
CRON_SCHEDULE_DROP=*/1 * * * *  

# Logging
LOG_LEVEL=info

RSI_TIMEFRAMES=Min5, Min15, Min30, Min60, Hour4, Hour8, Day1
RSI_OVERBOUGHT_THRESHOLD=80
RSI_CONFLUENCE_MIN_TIMEFRAMES=3
RSI_OVERSOLD_THRESHOLD=26
TELEGRAM_DISABLE_NOTIFICATION=false
RSI_OVERBOUGHT_THRESHOLD_SMALL=85

# Group Chat ID (số âm, ví dụ: -1001234567890)
TELEGRAM_GROUP_ID=

# Topic/Thread ID (số dương, ví dụ: 123456)
TELEGRAM_TOPIC_ID=

TELEGRAM_SIGNAL_TOPIC_ID=
TELEGRAM_STRATEGY_CHECKING_LOG_TOPIC_ID=

RSI_MAX_CONCURRENT_TIMEFRAMES=10  # Số timeframes xử lý song song (mặc định: 2)
RSI_MAX_CONCURRENT_TOKENS=5    # Số tokens xử lý song song (mặc định: 3)
RSI_DELAY_BETWEEN_TIMEFRAMES=100 # Delay giữa batch timeframes (ms)
RSI_DELAY_BETWEEN_TOKENS=100

SINGLE_SIGNAL_RSI_WEIGHT_LARGE=6
SINGLE_SIGNAL_RSI_WEIGHT_MEDIUM=4
SINGLE_SIGNAL_RSI_WEIGHT_SMALL=3

SINGLE_SIGNAL_RSI_DELTA=5
SINGLE_SIGNAL_RSI_MAX_MULTIPLIER=10


SINGLE_SIGNAL_RSI_MAX_SCORE=70
SINGLE_SIGNAL_RSI_WEIGHT_LARGE=6.5
SINGLE_SIGNAL_RSI_WEIGHT_MEDIUM=4.55
SINGLE_SIGNAL_RSI_WEIGHT_SMALL=3.25

SINGLE_SIGNAL_DIVERGENCE_MAX_SCORE=10
SINGLE_SIGNAL_DIVERGENCE_WEIGHT_LARGE=5
SINGLE_SIGNAL_DIVERGENCE_WEIGHT_MEDIUM=3
SINGLE_SIGNAL_DIVERGENCE_WEIGHT_SMALL=1.5
SINGLE_SIGNAL_DIVERGENCE_BONUS=0.5

SINGLE_SIGNAL_CANDLE_MAX_SCORE=20
SINGLE_SIGNAL_CANDLE_WEIGHT_LARGE=10
SINGLE_SIGNAL_CANDLE_WEIGHT_MEDIUM=6
SINGLE_SIGNAL_CANDLE_WEIGHT_SMALL=3
SINGLE_SIGNAL_CANDLE_BONUS=1

SINGLE_SIGNAL_MIN_TOTAL_SCORE=15

EXCHANGE_PROVIDER=bingx

# ==============================================================================
# EXCHANGE API KEYS
# Chọn exchange bằng EXCHANGE_PROVIDER: bingx | mexc | binance
# ==============================================================================

# --- BingX Futures ---
BINGX_API_KEY=
BINGX_API_SECRET=
# BINGX_BASE_URL=https://open-api.bingx.com   # Mặc định, không cần đổi

# --- MEXC Futures ---
MEXC_API_KEY=
MEXC_SECRET_KEY=
# MEXC Futures base URL mặc định: https://contract.mexc.com

# --- Binance Futures (USDT-M) ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# BINANCE_BASE_URL=https://fapi.binance.com   # Mặc định, không cần đổi

# ==============================================================================
# TRADING CONFIGURATION
# ==============================================================================

# Funding cycle skip (1 = 1h, 4 = 4h, 8 = 8h)
TRADING_FUNDING_COLLECT_CYCLE_SKIP=1

# Take Profit Configuration
TP_ENABLED=false                  # Bật/tắt take profit tự động
# TP_price = avg_entry × (1 - pump% × ratio)
# Ví dụ pump 50%, TP_RATIO_1=0.20 → chốt ở -10% từ entry
TP_RATIO_1=0.20                   # TP1: pump% × 20%
TP_RATIO_2=0.40                   # TP2: pump% × 40%
TP_RATIO_3=0.80                   # TP3: pump% × 80%
TP_CLOSE_PERCENT_1=30             # Đóng 30% position tại TP1
TP_CLOSE_PERCENT_2=30             # Đóng 30% position tại TP2
TP_CLOSE_PERCENT_3=40             # Đóng 40% position tại TP3
TP_BREAKEVEN_SL_ENABLED=true      # Kéo SL về entry khi TP1 khớp
TP_MONITOR_INTERVAL_MS=60000      # Kiểm tra TP fill mỗi 60 giây